<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_env_ribbon_audit_log_list" model="ir.ui.view">
        <field name="name">env.ribbon.audit.log.list</field>
        <field name="model">env.ribbon.audit.log</field>
        <field name="arch" type="xml">
            <list string="Production Access Log" create="false" edit="false">
                <field name="access_time"/>
                <field name="user_id"/>
                <field name="action_type"/>
                <field name="ip_address"/>
                <field name="user_agent"/>
            </list>
        </field>
    </record>

    <record id="action_env_ribbon_audit_log" model="ir.actions.act_window">
        <field name="name">Production Access Log</field>
        <field name="res_model">env.ribbon.audit.log</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem
        id="menu_env_ribbon_root"
        name="Environment Ribbon"
        parent="base.menu_administration"
        sequence="100"
    />
    <menuitem
        id="menu_env_ribbon_audit_log"
        name="Production Access Log"
        parent="menu_env_ribbon_root"
        action="action_env_ribbon_audit_log"
        sequence="10"
    />
</odoo>
