#. view: help texts
msgid "Show a visual environment indicator on all backend pages."
msgstr "Tampilkan indikator visual environment di semua halaman backend."

msgid "Detected value of the ODOO_ENV environment variable. When set, it overrides manual configuration."
msgstr "Nilai variabel ODOO_ENV yang terdeteksi. Jika diset, akan menggantikan konfigurasi manual."

msgid "Ribbon color and text will automatically adjust based on the selected environment."
msgstr "Warna dan teks ribbon akan menyesuaikan otomatis sesuai environment yang dipilih."

msgid "Custom ribbon text. Leave empty to use the default environment label."
msgstr "Teks ribbon kustom. Kosongkan untuk menggunakan label default environment."

msgid "Position of the ribbon on screen."
msgstr "Posisi ribbon di layar."

msgid "Users can hide the ribbon for the day. Automatically disabled for Production environments."
msgstr "User dapat menyembunyikan ribbon untuk hari ini. Otomatis dinonaktifkan untuk environment Production."

msgid "Log every session that accesses the Production environment."
msgstr "Catat setiap sesi yang mengakses environment Production."

