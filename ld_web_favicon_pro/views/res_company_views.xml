<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend res.company form view to add Favicon tab -->
    <record id="view_company_form_favicon" model="ir.ui.view">
        <field name="name">res.company.form.favicon</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Favicon" name="favicon_settings" groups="base.group_system">
                    <group>
                        <group string="Favicon Settings">
                            <field name="favicon_auto_generated" widget="boolean_toggle"/>
                            <field name="favicon_environment_badge"/>
                        </group>
                        <group string="Manual Favicon">
                            <field name="favicon" widget="image"
                                   options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.webp,.bmp,.tiff,.tif', 'size': [64, 64]}"
                                   readonly="favicon_auto_generated"/>
                        </group>
                    </group>

                    <group string="Generated Icons (read-only)">
                        <group>
                            <field name="apple_touch_icon" widget="image"
                                   string="Apple Touch Icon (180×180)"
                                   options="{'size': [60, 60]}" readonly="1"/>
                            <field name="android_icon_192" widget="image"
                                   string="Android Chrome 192×192"
                                   options="{'size': [60, 60]}" readonly="1"/>
                        </group>
                        <group>
                            <field name="android_icon_512" widget="image"
                                   string="Android Chrome 512×512"
                                   options="{'size': [60, 60]}" readonly="1"/>
                        </group>
                    </group>

                    <div class="mt-3 mb-2">
                        <button name="action_generate_favicon" type="object"
                                string="Generate Favicon from Logo"
                                class="btn btn-primary me-2"
                                icon="fa-magic"/>
                        <button name="action_clear_favicon" type="object"
                                string="Clear Favicon Cache"
                                class="btn btn-secondary"
                                icon="fa-trash"/>
                    </div>

                    <div class="mt-3 text-muted small border-top pt-3">
                        <p><strong>Available URLs after generation:</strong></p>
                        <ul>
                            <li><code>/ld_favicon/favicon.ico</code> — Favicon per company (ICO)</li>
                            <li><code>/ld_favicon/apple-touch-icon.png</code> — Apple Touch Icon</li>
                            <li><code>/ld_favicon/android-chrome-192x192.png</code> — Android Chrome 192</li>
                            <li><code>/ld_favicon/android-chrome-512x512.png</code> — Android Chrome 512</li>
                            <li><code>/ld_favicon/site.webmanifest</code> — Web App Manifest JSON</li>
                        </ul>
                    </div>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
