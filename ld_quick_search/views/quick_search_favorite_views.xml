<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quick_search_favorite_list" model="ir.ui.view">
        <field name="name">ld.quick_search.favorite.list</field>
        <field name="model">ld.quick_search.favorite</field>
        <field name="arch" type="xml">
            <list string="Favorite Quick Searches" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="user_id"/>
                <field name="label"/>
                <field name="action_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
            </list>
        </field>
    </record>

    <record id="action_quick_search_favorite" model="ir.actions.act_window">
        <field name="name">Favorite Quick Searches</field>
        <field name="res_model">ld.quick_search.favorite</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_quick_search_favorite"
              name="Favorites"
              parent="menu_quick_search_root"
              action="action_quick_search_favorite"
              sequence="20"/>

</odoo>
