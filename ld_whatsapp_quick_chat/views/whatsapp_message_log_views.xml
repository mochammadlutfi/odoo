<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_message_log_list" model="ir.ui.view">
        <field name="name">whatsapp.message.log.list</field>
        <field name="model">whatsapp.message.log</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Logs" create="false">
                <field name="send_time"/>
                <field name="partner_id"/>
                <field name="phone_sent"/>
                <field name="template_id"/>
                <field name="user_id"/>
                <field name="related_model"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_message_log_form" model="ir.ui.view">
        <field name="name">whatsapp.message.log.form</field>
        <field name="model">whatsapp.message.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="send_time"/>
                        <field name="partner_id"/>
                        <field name="phone_sent"/>
                        <field name="template_id"/>
                        <field name="user_id"/>
                        <field name="related_model"/>
                        <field name="related_id"/>
                    </group>
                    <group string="Message Body">
                        <field name="message_body" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_message_log" model="ir.actions.act_window">
        <field name="name">WhatsApp Log</field>
        <field name="res_model">whatsapp.message.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
