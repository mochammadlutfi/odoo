<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_send_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.send.wizard.form</field>
        <field name="model">whatsapp.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp">
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="phone"/>
                        <field name="phone_normalized" readonly="1"/>
                        <field name="phone_valid" invisible="1"/>
                    </group>
                    <group>
                        <field name="template_id"
                               options="{'no_create_edit': True}"/>
                        <field name="related_model" invisible="1"/>
                        <field name="related_id" invisible="1"/>
                    </group>
                </group>
                <div invisible="phone_valid" class="alert alert-warning">
                    Phone number is invalid. Please fix the format (e.g. 0812-..., +62 812-..., or 812...).
                </div>
                <group string="Message">
                    <field name="message" nolabel="1" placeholder="Type your WhatsApp message here..."/>
                </group>
                <footer>
                    <button name="action_open_whatsapp"
                            string="Open WhatsApp"
                            type="object"
                            class="btn-primary"
                            invisible="not phone_valid"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
