<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_bulk_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.bulk.wizard.form</field>
        <field name="model">whatsapp.bulk.wizard</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Bulk Send">
                <group>
                    <group>
                        <field name="partner_count" readonly="1"/>
                        <field name="valid_partner_count" readonly="1"/>
                        <field name="invalid_partner_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="template_id" required="1"/>
                        <field name="related_model" invisible="1"/>
                    </group>
                </group>
                <div class="alert alert-info">
                    Due to browser popup-blocker limits, only the first tab opens automatically.
                    Use this for small broadcasts (&lt;10 recipients), or upgrade to F6 (Fonnte/Wablas)
                    for API-based broadcast.
                </div>
                <group string="Preview (first partner)">
                    <field name="message_preview" nolabel="1" readonly="1"/>
                </group>
                <field name="partner_ids" invisible="1"/>
                <footer>
                    <button name="action_bulk_send"
                            string="Open First WhatsApp Tab"
                            type="object"
                            class="btn-primary"
                            invisible="valid_partner_count == 0"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_bulk_whatsapp" model="ir.actions.server">
        <field name="name">Send WhatsApp Broadcast</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_send_whatsapp()</field>
    </record>

</odoo>
